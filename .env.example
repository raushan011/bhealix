# Database
MONGODB_URI=mongodb://127.0.0.1:27017/bhealix_crm

# Signs the session JWT, and derives the key that encrypts the Shopify and
# Shiprocket credentials at rest. Changing it signs everybody out AND makes
# those two credentials unreadable — they are re-entered under Sales settings.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Google Cloud: enable Places API (New) + Geocoding API, restrict the key to both
GOOGLE_MAPS_SERVER_API_KEY=

# Public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Lets a scheduler call GET /api/sales/cron, which pulls Shopify and Shiprocket
# overnight and re-prices commissions whose hold period has elapsed. Presented
# as `Authorization: Bearer <secret>`; Vercel Cron sends this automatically.
# Left blank, only a signed-in administrator can trigger that pass.
CRON_SECRET=

# The Shopify and Shiprocket credentials are NOT environment variables. They are
# entered under Sales settings and stored encrypted, so they can be changed
# without a redeploy — the same reasoning as the billing GSTIN.
